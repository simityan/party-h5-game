// ============================================
// Party H5 Game — Prisma Schema (V2)
// 害你在心口难开·动作版 — V2 规则补充版
// ============================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 游戏房间
// ============================================
model Game {
  id          String   @id @default(uuid())
  code        String   @unique // 游戏入场码，用于扫码/链接
  status      GameStatus @default(WAITING)

  // 配置
  playerCount Int      @default(6) // 4-8人
  startTime   DateTime? // 可选，预设开始时间
  endTime     DateTime  // 预设结束时间

  // 团队奖惩（JSON数组，纯展示）
  teamRewards   Json @default("[]") // ["海马体四人闺蜜套餐", ...]
  teamPunishments Json @default("[]") // ["合唱一首歌", "真心话大冒险", ...]

  // 时间戳
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  startedAt   DateTime? // 实际开始时间
  endedAt     DateTime? // 实际结束时间

  // 关联
  players     Player[]
  events      GameEvent[]
  tips        AnonymousTip[]

  @@map("games")
}

// ============================================
// 玩家
// ============================================
model Player {
  id        String  @id @default(uuid())
  gameId    String
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  openId    String  // 微信OpenID，唯一身份标识
  nickname  String  // 输入的昵称
  avatar    String? // 头像URL（可选）

  score     Int     @default(0) // 积分
  isBottom2 Boolean @default(false) // 是否处于后2名（运行时计算，此处缓存）
  votedEnd  Boolean @default(false) // 是否已点击结束游戏

  // V2: 刷新次数（初始3次，3卡全部resolve时+3，否认时双方各+1）
  refreshChances Int @default(3)

  // 统计字段（结算用，游戏中持续更新）
  tasksCompleted     Int @default(0) // 成功完成的任务数
  tasksDenied        Int @default(0) // 声明完成被否认的次数
  challengesMade     Int @default(0) // 发起质疑的次数
  challengesSucceeded Int @default(0) // 质疑成功的次数
  challengesReceived Int @default(0) // 被质疑的次数
  challengesHit      Int @default(0) // 被质疑命中的次数（质疑失败=没被命中）
  timesTargeted      Int @default(0) // 被指定为目标的次数
  punishmentsReceived Int @default(0) // 接受惩罚的次数
  extremeTasksDrawn  Int @default(0) // 拿到超难任务的次数
  totalTasksDrawn    Int @default(0) // 总共抽到的任务数

  // 加入时间
  joinedAt  DateTime @default(now())

  // 关联
  tasks             PlayerTask[]
  declareCompletions DeclareComplete[] @relation("Declarer")
  targetCompletions  DeclareComplete[] @relation("Target")
  challengesMade_rel Challenge[] @relation("Challenger")
  challengesReceived_rel Challenge[] @relation("Challenged")
  pendingMessages   PendingMessage[]

  @@unique([gameId, openId]) // 同一游戏中OpenID唯一
  @@index([gameId])
  @@map("players")
}

// ============================================
// 玩家手牌（当前任务）— V2 目标体系
// ============================================
model PlayerTask {
  id        String  @id @default(uuid())
  playerId  String
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameId    String  // 冗余，方便查询

  // 任务内容（从任务库抽取时快照，不引用库ID，因为允许重复抽取）
  content   String  // 任务内容
  difficulty TaskDifficulty // 难度
  points    Int     // 积分：EASY=1, MEDIUM=2, HARD=3, EXTREME=5
  taskType  String  @default("BEHAVIOR") // 任务类型：VERBAL/BEHAVIOR/EMOTIONAL/REVERSE

  // V2 目标体系 — 按难度自动分配
  // Easy: 1主目标; Medium: 1主+1次; Hard: 1主+3次; Extreme: 1主+全员次
  primaryTargetId   String                // 主目标玩家ID
  primaryTargetName String                // 主目标昵称（冗余展示）
  secondaryTargetIds   Json @default("[]") // 次要目标ID列表 ["id1","id2"]
  secondaryTargetNames Json @default("[]") // 次要目标昵称列表 ["Alice","Bob"]

  // 绑定惩罚（同难度随机绑定的惩罚内容快照）
  punishmentContent String // 惩罚内容

  // 状态 — V2: ACTIVE/COMPLETED/CHALLENGED/CANCELED (移除DENIED和DISCARDED)
  status    PlayerTaskStatus @default(ACTIVE)
  declaredAt DateTime? // 声明完成的时间（只能声明一次）

  // 时间
  drawnAt   DateTime @default(now()) // 抽取时间
  removedAt DateTime? // 移除时间

  // 关联
  declareComplete DeclareComplete? // 声明完成记录（一条任务最多一次）
  challengeHit    Challenge[]      // 被质疑命中的记录

  @@index([playerId, status])
  @@index([gameId, status])
  @@map("player_tasks")
}

// ============================================
// 声明完成
// ============================================
model DeclareComplete {
  id          String  @id @default(uuid())
  gameId      String
  taskId      String  @unique // PlayerTask ID — 一条任务只能声明一次
  task        PlayerTask @relation(fields: [taskId], references: [id])

  declarerId  String  // 声明方
  declarer    Player  @relation("Declarer", fields: [declarerId], references: [id])
  targetId    String  // 目标方（V2: 来自任务的 primaryTargetId）
  target      Player  @relation("Target", fields: [targetId], references: [id])

  // 任务和惩罚内容快照（确认弹窗展示用）
  taskContent       String
  punishmentContent String

  // 确认结果
  status      ConfirmStatus @default(PENDING) // PENDING/CONFIRMED/DENIED
  confirmedAt DateTime?

  createdAt   DateTime @default(now())

  @@map("declare_completions")
}

// ============================================
// 质疑 — V2 自动匹配（不再需要手动确认）
// ============================================
model Challenge {
  id            String  @id @default(uuid())
  gameId        String

  challengerId  String  // 质疑方
  challenger    Player  @relation("Challenger", fields: [challengerId], references: [id])
  challengedId  String  // 被质疑方
  challenged    Player  @relation("Challenged", fields: [challengedId], references: [id])

  guessContent  String  // 猜测的任务内容

  // V2: 系统自动判定，创建时即确定结果
  status        ChallengeStatus // HIT/MISS (移除PENDING)

  // V2: 自动匹配信息
  similarityScore Float? // 相似度分数 (0-1)
  hitTaskId     String?  @unique // 自动匹配到的任务ID（命中时）；唯一约束防止同一任务被重复命中
  hitTask       PlayerTask? @relation(fields: [hitTaskId], references: [id], onDelete: SetNull)

  // 快照（结算回放用）
  hitTaskContent     String? // 被命中的任务内容
  hitPunishmentContent String? // 被命中的惩罚内容

  resolvedAt    DateTime? // V2: 创建时即设置
  createdAt     DateTime @default(now())

  @@index([gameId])
  @@index([challengerId])
  @@index([challengedId])
  @@map("challenges")
}

// ============================================
// 动态流事件
// ============================================
model GameEvent {
  id        String     @id @default(uuid())
  gameId    String
  game      Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)

  type      EventType  // COMPLETED/CHALLENGED
  content   Json       // 事件内容（灵活JSON）

  createdAt DateTime   @default(now())

  @@index([gameId])
  @@map("game_events")
}

// ============================================
// 匿名爆料
// ============================================
model AnonymousTip {
  id            String  @id @default(uuid())
  gameId        String
  game          Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  content       String  // 爆料文案
  sourceTaskId  String? // 来源任务ID（任务被刷新/完成后该爆料消失）
  isActive      Boolean @default(true)

  createdAt     DateTime @default(now())

  @@index([gameId, isActive])
  @@map("anonymous_tips")
}

// ============================================
// 待处理消息（轮询用）
// V2: 仅用于声明完成确认（质疑不再需要手动确认）
// ============================================
model PendingMessage {
  id        String  @id @default(uuid())
  playerId  String
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameId    String

  type      MessageType // V2: 仅 DECLARE_COMPLETE
  relatedId String  // 关联的DeclareComplete的ID
  content   Json    // 消息内容快照

  isRead    Boolean @default(false)
  isHandled Boolean @default(false) // 是否已处理（确认/否认）

  createdAt DateTime @default(now())
  handledAt DateTime?

  @@index([playerId, isHandled])
  @@index([gameId])
  @@map("pending_messages")
}

// ============================================
// 任务库（从JSON导入）— V2: 移除targetType，由难度决定目标
// ============================================
model TaskLibrary {
  id          String       @id @default(uuid())
  difficulty  TaskDifficulty
  content     String       // 任务内容（V2模板: "让目标玩家……"/"让目标玩家及次要玩家……"等）
  taskType    String       @default("BEHAVIOR") // VERBAL/BEHAVIOR/EMOTIONAL/REVERSE

  @@index([difficulty])
  @@map("task_library")
}

// ============================================
// 惩罚库（从JSON导入）
// ============================================
model PunishmentLibrary {
  id          String       @id @default(uuid())
  difficulty  TaskDifficulty
  content     String       // 惩罚内容

  @@index([difficulty])
  @@map("punishment_library")
}

// ============================================
// 枚举
// ============================================
enum GameStatus {
  WAITING    // 等待玩家加入
  PLAYING    // 游戏进行中
  ENDED      // 游戏已结束
}

enum TaskDifficulty {
  EASY       // 🟢 简单
  MEDIUM     // 🟡 中等
  HARD       // 🔴 困难
  EXTREME    // 💀 超难
}

enum PlayerTaskStatus {
  ACTIVE     // 当前手牌
  COMPLETED  // 已完成（目标确认）
  CHALLENGED // 被质疑命中 / V2否认后也归入此状态
  CANCELED   // 游戏结束时未完成，自动取消
}

enum ConfirmStatus {
  PENDING    // 等待确认
  CONFIRMED  // 目标确认
  DENIED     // 目标否认
}

enum ChallengeStatus {
  HIT        // V2: 系统自动判定猜中
  MISS       // V2: 系统自动判定未猜中
}

enum EventType {
  COMPLETED  // 任务完成
  CHALLENGED // 质疑成功
}

enum MessageType {
  DECLARE_COMPLETE // V2: 仅声明完成确认（质疑不再需要手动确认）
}
